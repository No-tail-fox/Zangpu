# Publish only through the loopback reverse proxy during local verification.
CALLER_PORT=9000
ADMIN_PORT=9001

# Supply a license-verified immutable Bifrost image reference, preferably by digest.
BIFROST_IMAGE=
BIFROST_EXPECTED_VERSION=v1.6.3
BIFROST_MANAGEMENT_TOKEN=

# Internal Open WebUI origin reachable from the compose network. Mirror the service
# ID and Secret into Open WebUI's ZANGPU_INTERNAL_SERVICE_ID/SECRET settings and
# configure its ZANGPU_INTERNAL_ALLOWED_CIDRS for the backend network.
OPENWEBUI_INTERNAL_BASE_URL=
OPENWEBUI_INTERNAL_SERVICE_ID=zangpu-api-control-plane
OPENWEBUI_INTERNAL_SERVICE_SECRET=

# Generate independent high-entropy values; do not reuse these across environments.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ADMIN_SESSION_SECRET=
# JSON map of key versions to base64-encoded 32-byte AES keys. No working default is shipped.
API_CREDENTIAL_KEYS=
API_CREDENTIAL_ACTIVE_KEY_ID=
